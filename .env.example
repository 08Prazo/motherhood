# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects GEMINI_API_KEY at runtime.
# For Netlify deployment, add either GEMINI_API_KEY, API_KEY, VITE_GEMINI_API_KEY, or VITE_API_KEY
# in your Netlify site settings (Site configuration -> Environment variables).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
API_KEY="MY_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
